{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "incremental": true,
    "paths": {
      "@eaip/design-tokens": ["./packages/design-tokens/src"],
      "@eaip/theme": ["./packages/theme/src"],
      "@eaip/icons": ["./packages/icons/src"],
      "@eaip/typography": ["./packages/typography/src"],
      "@eaip/ui-primitives": ["./packages/ui-primitives/src"],
      "@eaip/ui-foundation": ["./packages/ui-foundation/src"],
      "@eaip/ui-enterprise": ["./packages/ui-enterprise/src"],
      "@eaip/ui-visualizations": ["./packages/ui-visualizations/src"],
      "@eaip/api": ["./packages/api/src"],
      "@eaip/auth": ["./packages/auth/src"],
      "@eaip/realtime": ["./packages/realtime/src"],
      "@eaip/agent": ["./packages/agent/src"],
      "@eaip/workflow": ["./packages/workflow/src"],
      "@eaip/memory": ["./packages/memory/src"],
      "@eaip/knowledge": ["./packages/knowledge/src"],
      "@eaip/hooks": ["./packages/hooks/src"],
      "@eaip/utilities": ["./packages/utilities/src"],
      "@eaip/state": ["./packages/state/src"],
      "@eaip/telemetry": ["./packages/telemetry/src"],
      "@eaip/logging": ["./packages/logging/src"],
      "@eaip/feature-flags": ["./packages/feature-flags/src"],
      "@eaip/config": ["./packages/config/src"],
      "@eaip/accessibility": ["./packages/accessibility/src"],
      "@eaip/testing": ["./packages/testing/src"]
    }
  },
  "exclude": ["node_modules"]
}
