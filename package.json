{
  "name": "eaip-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "EAIP Frontend — Enterprise AI Platform user interface monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:packages": "turbo build --filter=./packages/*",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,scss,yaml,yml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,scss,yaml,yml}\"",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rimraf node_modules",
    "storybook": "turbo storybook",
    "storybook:build": "turbo storybook:build",
    "chromatic": "turbo chromatic",
    "e2e": "turbo e2e",
    "e2e:ui": "turbo e2e:ui",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky",
    "postinstall": "pnpm build:packages"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "^16.2.0",
    "@playwright/test": "^1.52.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-actions": "^9.0.0",
    "@storybook/addon-controls": "^9.0.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^10.4.0",
    "@storybook/addon-storysource": "^8.6.0",
    "@storybook/addon-viewport": "^9.0.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/nextjs": "^10.4.0",
    "@storybook/react": "^10.4.0",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.24.0",
    "@storybook/testing-library": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "vite-tsconfig-paths": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "chromatic": "^18.0.0",
    "concurrently": "^10.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.2.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-tailwindcss": "^4.0.0",
    "eslint-plugin-testing-library": "^7.16.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^17.0.0",
    "msw": "^2.7.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rimraf": "^6.0.0",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "turbo": "^2.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yaml,yml}": [
      "prettier --write"
    ]
  }
}
