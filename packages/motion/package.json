    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@eaip/design-tokens": "workspace:*",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
