{
  "name": "@eaip/motion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/css/motion.css"
  },
  "scripts": {
    "test": "vitest run",
